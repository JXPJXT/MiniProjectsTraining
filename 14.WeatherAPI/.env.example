# ============================================
# Rajasthan Weather & Air Quality Monitor
# Environment Variables
# ============================================

# --- Supabase Configuration ---
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key
SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# --- Frontend (Next.js) ---
# These MUST be prefixed with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# --- Optional ---
# Log level for backend (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Number of retry attempts for API calls
MAX_RETRIES=3
